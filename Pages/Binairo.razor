@page "/binairo"
@using PuzzleLogique.Components.Grid
@using PuzzleLogique.Models
@using PuzzleLogique.Services
@inject IPuzzleService PuzzleService

<PageTitle>Binairo - Puzzles Logiques</PageTitle>

<div class="container">
    <h1 class="text-center my-4">Binairo</h1>
    
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center">Grille de Binairo</h2>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <GridComponent @ref="gridComponent" />
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3>Règles du Binairo</h3>
                </div>
                <div class="card-body">
                    <p>Le Binairo est un jeu de logique où vous devez remplir une grille avec des 0 et des 1, de sorte que chaque ligne et chaque colonne contienne un nombre égal de 0 et de 1, et qu'il n'y ait pas plus de deux 0 ou 1 consécutifs.</p>
                    
                    <h4>Comment jouer :</h4>
                    <ol>
                        <li>Cliquez sur une cellule vide pour la sélectionner.</li>
                        <li>Utilisez les boutons "0" et "1" pour entrer une valeur.</li>
                        <li>Utilisez le bouton "Effacer" pour vider une cellule.</li>
                        <li>Cliquez sur "Vérifier" pour valider votre grille.</li>
                        <li>Les cellules en conflit seront marquées en rouge.</li>
                        <li>Vous pouvez ajuster la taille de la grille et générer de nouveaux puzzles.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private GridComponent? gridComponent;
    
    protected override void OnInitialized()
    {
        // Cette méthode sera appelée lorsque le composant sera initialisé
    }
    
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && gridComponent != null)
        {
            // Configurer le composant de grille pour le Binairo
            // Cette partie sera exécutée après le premier rendu
        }
    }
}

